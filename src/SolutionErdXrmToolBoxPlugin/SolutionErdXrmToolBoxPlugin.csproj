<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Avoid duplicate attributes if you have Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- If any .resx has non-string entries (icons/images), keep this true -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

    <AssemblyName>SolutionErdXrmToolBoxPlugin</AssemblyName>
    <RootNamespace>SolutionErdXrmToolBoxPlugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Title>Solution ERD Builder</Title>
    <Version>0.1.0.1</Version>
    <Authors>Samuel Hurley</Authors>
    <Company>Procentrix</Company>
    <Copyright>Copyright (c) Samuel Hurley 2026</Copyright>
    <Description>Draws readable ERDs of the tables in a Dataverse solution, split into subject-area pages, and exports them to draw.io. Alpha.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Suppress framework folder in package -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5100/NU5128: expected for XrmToolBox plugins (DLLs go in Plugins/, not lib/) -->
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>

    <!-- NuGet Package Metadata -->
    <PackageProjectUrl>https://github.com/HurleySk/xrmtoolbox-erd</PackageProjectUrl>
    <PackageIcon>icon-128.png</PackageIcon>
    <!-- The XrmToolBox Tool Library shows the icon from this URL, not the embedded one -->
    <PackageIconUrl>https://raw.githubusercontent.com/HurleySk/xrmtoolbox-erd/main/src/SolutionErdXrmToolBoxPlugin/Resources/icon-128.png</PackageIconUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>XrmToolBox;Dynamics365;Dataverse;PowerPlatform;ERD;Diagram;drawio</PackageTags>
    <PackageReleaseNotes>First alpha. Pick a solution, preview its ERD page by page (an overview of subject areas, then one page per area) and export to draw.io. System relationships are hidden, and lookups to tables on other pages or outside the solution are shown as row text instead of lines. Metadata can be saved to a file and opened later without a connection. Visio export is not in this version.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/HurleySk/xrmtoolbox-erd</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- XrmToolBox plugin infrastructure -->
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.7.71" />

    <!-- Connection lib (includes WinForms login control) -->
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.7.63" />

    <!-- Dynamics 365 / Dataverse SDK -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" />
    <PackageReference Include="Microsoft.CrmSdk.Deployment" Version="9.0.2.34" />
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" Version="9.1.1.65" />

    <!-- SDK tools (build-time only) -->
    <PackageReference Include="Microsoft.CrmSdk.CoreTools" Version="9.0.3.1" PrivateAssets="All" />

    <!-- Non-string .resx support at runtime -->
    <PackageReference Include="System.Resources.Extensions" Version="4.7.1" />

  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\icon-128.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Manually include DLL in Plugins folder without framework subfolder -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="Plugins\" />
    <!-- Dependency DLLs go in Plugins\Dependencies so the Tool Store version check only sees the plugin DLL -->
    <None Include="$(OutputPath)\SolutionErd.Core.dll" Pack="true" PackagePath="Plugins\Dependencies\" />
    <None Include="$(OutputPath)\AutomaticGraphLayout.dll" Pack="true" PackagePath="Plugins\Dependencies\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped inside the package (Plugins\Dependencies), so not a NuGet dependency -->
    <ProjectReference Include="..\SolutionErd.Core\SolutionErd.Core.csproj" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

</Project>
